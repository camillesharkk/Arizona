# Copy to .env.local. Never commit real secrets.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JWT signing secret (32+ characters)
AUTH_SECRET=replace-with-a-long-random-string

# Postgres (Neon) — if unset, a local .data/store.json file is used (not durable on Vercel)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=Arizona Exam <hello@yourdomain.com>

# AI Tutor (OpenAI-compatible). If unset, grounded handbook fallback is used.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Merchant of Record: mock | paddle | lemonsqueezy
MOR_PROVIDER=mock
# MOR_WEBHOOK_SECRET=
# PADDLE_PRICE_ID=
# LEMONSQUEEZY_CHECKOUT_URL=

# Affiliate URLs (optional overrides)
# NEXT_PUBLIC_AFFILIATE_NNA=
# NEXT_PUBLIC_AFFILIATE_NOTARYNET=
# NEXT_PUBLIC_AFFILIATE_NPU=
# NEXT_PUBLIC_AFFILIATE_OTHER=

# Cron
# CRON_SECRET=
