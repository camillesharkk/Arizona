# Copy to .env.local. Never commit real secrets.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 Measurement ID (public, not a secret). Example: G-XXXXXXXXXX
# Unset: site runs normally and does not load GA. Production only; localhost/dev never sends.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Product analytics. Dev does not send unless NEXT_PUBLIC_ANALYTICS_DEBUG=1.
# NEXT_PUBLIC_ANALYTICS_DEBUG=1

# PostHog project key for browser + server capture (public project key, usually phc_...).
# Not a personal API key. Unset: product events are not sent. Host switches US/EU ingest.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU example: NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog server queries for the daily operations report. NEVER prefix with NEXT_PUBLIC_.
# Personal API key (phx_...) must not be bundled into client JavaScript.
# POSTHOG_HOST is the app host (https://us.posthog.com or https://eu.posthog.com), not the ingest host.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.posthog.com

# Microsoft Clarity project id (public). Unset: Clarity is not loaded.
# Recording stays off until this is set. Sensitive routes are masked and recording is stopped.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Operations reporting (server-only). Public property IDs, not secrets.
# GA4_PROPERTY_ID=552874520
# GSC_SITE_URL=sc-domain:arizonanotaryprep.com
# Google service account for Analytics Data API + Search Console API (Viewer only).
# Use either the split vars or the JSON. Never commit the private key. Never log it.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Save a JSON file outside git, e.g. %USERPROFILE%\.secrets\arizona-ops-readonly.json
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\YOU\.secrets\arizona-ops-readonly.json
# Vercel Production can use the same JSON as a secret named GOOGLE_SERVICE_ACCOUNT_JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# Vercel REST API for production deployment state. Server-only. Never NEXT_PUBLIC_.
# Runtime log streams are not stored; deployment ERROR/READY counts are.
# VERCEL_ACCESS_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Comma-separated emails allowed to open /admin/operations/. Server-only. Never NEXT_PUBLIC_.
# The page uses the existing login session. Do not put a token in the URL.
# OPERATIONS_ADMIN_EMAILS=

# JWT signing secret (32+ characters)
AUTH_SECRET=replace-with-a-long-random-string

# Account deletion tombstone HMAC (server-only). Independent from AUTH_SECRET
# so session rotation cannot unlock past New Member / Referral offers.
# Never prefix with NEXT_PUBLIC_. Do not reuse AUTH_SECRET.
ACCOUNT_TOMBSTONE_SECRET=replace-with-a-long-random-string

# Neon Postgres. If unset, a local .data/store.json file is used (not durable on Vercel).
# After creating a Neon project: Connect → copy the connection string.
# Local migrate: prefer Direct (non-pooled). Vercel: pooled (-pooler) is fine.
# Then run: npm run db:migrate
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Email (Resend). Server-only — never prefix with NEXT_PUBLIC_
# RESEND_API_KEY=
# After a custom domain is verified in Resend, set EMAIL_FROM. Until then the app uses:
# Arizona Notary Prep <onboarding@resend.dev>
# EMAIL_FROM=Arizona Notary Prep <hello@yourdomain.com>

# AI Tutor (server-only — never prefix with NEXT_PUBLIC_)
# AI_PROVIDER=local     → local grounded Tutor
# AI_PROVIDER=deepseek  → DeepSeek API + grounded fallback
# AI_MODEL defaults to deepseek-v4-flash when unset.
# AI_PROVIDER_DAILY_CAP is the site-wide max DeepSeek provider calls per UTC day.
# Unset keeps local/dev behavior (no site-wide provider cap).
AI_PROVIDER=local
DEEPSEEK_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_PROVIDER_DAILY_CAP=

# Lemon Squeezy Test / Live (server-only — never prefix with NEXT_PUBLIC_)
# Use mock for local unpaid testing. Set MOR_PROVIDER=lemonsqueezy only with credentials
# from the same Lemon environment as LEMONSQUEEZY_TEST_MODE.
# API_KEY / STORE_ID / VARIANT_ID / WEBHOOK_SECRET must all come from that same Test or Live store.
# LEMONSQUEEZY_TEST_MODE must be exactly true or false. No default.
MOR_PROVIDER=mock
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true   # Test Mode
# LEMONSQUEEZY_TEST_MODE=false  # Live Mode
# Legacy/deprecated. Dynamic checkout no longer uses a fixed overlay URL.
# LEMONSQUEEZY_CHECKOUT_URL=

# Paddle Billing Sandbox / Live (API_KEY and WEBHOOK_SECRET are server-only — never NEXT_PUBLIC_)
# MOR_PROVIDER=paddle enables Paddle Checkout. Keep mock for local unpaid testing.
# PADDLE_ENVIRONMENT must be exactly sandbox or production. No default. Never inferred from NODE_ENV.
# Transaction amounts always come from the server-side quote (finalPriceCents), not a catalog price.
# PADDLE_PRODUCT_ID is the catalog product id (pro_...). It is not a secret.
# PADDLE_PRICE_ID is legacy/unused for dynamic quote amounts. Do not use it to set order totals.
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN is the Paddle.js client token (public).
# NEXT_PUBLIC_PADDLE_ENV must be sandbox or production and should match PADDLE_ENVIRONMENT.
# Local Paddle overlay return testing should use npm run dev, not npm run start.
# next start uses production Secure cookies while localhost is HTTP, so the post-checkout redirect can drop the session.
# MOR_PROVIDER=paddle
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRODUCT_ID=
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENV=sandbox

# Affiliate URLs (optional overrides)
# NEXT_PUBLIC_AFFILIATE_NNA=
# NEXT_PUBLIC_AFFILIATE_NOTARYNET=
# NEXT_PUBLIC_AFFILIATE_NPU=
# NEXT_PUBLIC_AFFILIATE_OTHER=

# Cron (Vercel sends Authorization: Bearer CRON_SECRET automatically)
# CRON_SECRET=replace-with-a-long-random-string
# EMAIL_CRON_DAILY_CAP=25

# Operations daily-report endpoint (server-only). Use a separate random secret;
# never reuse AUTH_SECRET, CRON_SECRET, or a Paddle credential.
# Requests use: Authorization: Bearer <OPERATIONS_REPORT_TOKEN>
# OPERATIONS_REPORT_TOKEN=replace-with-a-long-random-string

# Contact form inbox (server-only — never NEXT_PUBLIC_). Inbox is not shown in the UI.
# CONTACT_TO_EMAIL=

# Reserved for a real domain mailbox later (e.g. support@yourdomain.com). Do not display until it exists.
# PUBLIC_SUPPORT_EMAIL=
